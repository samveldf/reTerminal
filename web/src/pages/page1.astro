---
import dayjs from 'dayjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGoogleHeadlines, type NewsTopic } from '../services/newsService';
import { getWeather } from '../services/weatherService';

const weather = await getWeather();
const news = await getGoogleHeadlines();
const now = dayjs();
const topicLabels: Record<NewsTopic, string> = {
  general: 'TOP',
  world: 'WORLD',
  society: 'LIFE',
  business: 'BIZ',
  science: 'SCI',
  health: 'HEALTH',
  culture: 'CULTURE',
  sports: 'SPORT',
  technology: 'TECH',
};
---

<BaseLayout>
  <main class="epaper-screen page1-screen">
    <header class="cyber-header page-header">
      <div class="page-marker">01</div>
      <div class="header-copy">
        <div class="header-kicker">DAILY SIGNAL / TOKYO</div>
        <div class="header-title">WEATHER + TOP STORIES</div>
      </div>
      <div class="header-status">
        <span>LIVE BRIEF</span>
        <strong>{now.format('MM-DD HH:mm')}</strong>
      </div>
    </header>

    <section class="panel weather-panel">
      <div class="section-bar">
        <span class="section-title">4-DAY FORECAST</span>
        <span class="section-meta">{weather.cityLabel.toUpperCase()} / JST</span>
      </div>
      <div class="weather-track">
        {
          weather.days.map((day, idx) => (
            <article class={`day-card tone-${idx + 1}`}>
              <div class="day-head">
                <span>{day.label}</span>
                <time>{day.date}</time>
              </div>
              <div class="condition-row">
                <span class="weather-icon" aria-hidden="true">
                  {day.icon}
                </span>
                <strong>{day.symbol}</strong>
              </div>
              <div class="day-desc">{day.description}</div>
              <div class="weather-metrics">
                <div class="temp-pair">
                  <strong>{day.maxTemp}°</strong>
                  <span>/ {day.minTemp}°</span>
                </div>
                <span class="humidity">H {day.humidity}%</span>
              </div>
              <div class="solar-window">
                <div class="solar-item sunrise">
                  <span class="solar-icon">↑</span>
                  <span class="solar-copy">
                    <>
                      <small>SUNRISE</small>
                      <strong>{day.sunrise}</strong>
                    </>
                  </span>
                </div>
                <div class="solar-item sunset">
                  <span class="solar-icon">↓</span>
                  <span class="solar-copy">
                    <>
                      <small>SUNSET</small>
                      <strong>{day.sunset}</strong>
                    </>
                  </span>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="panel news-panel">
      <div class="section-bar news-section-bar">
        <span class="section-title">EDITOR'S RADAR</span>
        <span class="section-meta">MULTI-SOURCE / MULTI-TOPIC</span>
      </div>
      <div class="headline-list">
        {
          news.headlines.slice(0, 6).map((item, idx) => (
            <article class="headline-item">
              <span class="headline-index">{String(idx + 1).padStart(2, '0')}</span>
              <span class={`topic-chip topic-${item.topic || 'general'}`}>
                {topicLabels[item.topic || 'general']}
              </span>
              <h2>{item.title}</h2>
              <span class="headline-source">{item.source || 'Google News'}</span>
            </article>
          ))
        }
      </div>
    </section>

    <div class="corner-note">1 / 3</div>
  </main>
</BaseLayout>

<style>
  .page1-screen {
    padding: 6px;
    gap: 6px;
    position: relative;
  }

  .page-header {
    height: 49px;
    flex: 0 0 49px;
    padding: 4px 7px;
    gap: 8px;
  }

  .page-marker {
    width: 38px;
    height: 35px;
    background: var(--line);
    color: #ffffff;
    display: grid;
    place-items: center;
    font-size: 22px;
    line-height: 22px;
    font-weight: 900;
  }

  .header-copy {
    flex: 1;
    min-width: 0;
  }

  .header-kicker {
    color: var(--accent);
    font-size: 9px;
    line-height: 10px;
    font-weight: 900;
    letter-spacing: 1.5px;
  }

  .header-title {
    color: var(--line);
    font-size: 24px;
    line-height: 25px;
    letter-spacing: 0.4px;
    white-space: nowrap;
  }

  .header-status {
    min-width: 126px;
    border-left: 4px solid var(--orange);
    padding-left: 8px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .header-status span {
    color: var(--accent);
    font-size: 9px;
    line-height: 11px;
    font-weight: 900;
    letter-spacing: 1px;
  }

  .header-status strong {
    color: var(--text);
    font-size: 16px;
    line-height: 18px;
  }

  .weather-panel {
    height: 207px;
    flex: 0 0 207px;
    padding: 5px 6px 6px;
  }

  .news-panel {
    flex: 1;
    min-height: 0;
    padding: 5px 6px 6px;
    border-color: var(--warn);
  }

  .section-bar {
    height: 21px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 2px solid var(--line);
    margin-bottom: 5px;
  }

  .section-title {
    color: var(--accent);
    font-size: 13px;
    line-height: 18px;
    font-weight: 900;
    letter-spacing: 0.8px;
  }

  .section-meta {
    color: var(--muted);
    font-size: 9px;
    line-height: 12px;
    font-weight: 800;
    letter-spacing: 0.5px;
  }

  .news-section-bar {
    border-bottom-color: var(--warn);
  }

  .weather-track {
    height: 167px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 5px;
  }

  .day-card {
    min-width: 0;
    border: 1px solid var(--line);
    border-top-width: 4px;
    padding: 5px 7px 6px;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .tone-2 {
    border-top-color: var(--orange);
  }

  .tone-3 {
    border-top-color: var(--accent);
  }

  .tone-4 {
    border-top-color: var(--warn);
  }

  .day-head {
    display: flex;
    justify-content: space-between;
    color: var(--accent);
    font-size: 13px;
    line-height: 15px;
    font-weight: 900;
  }

  .day-head time {
    color: var(--muted);
  }

  .condition-row {
    height: 29px;
    display: flex;
    align-items: center;
    gap: 5px;
    color: var(--line);
  }

  .weather-icon {
    width: 25px;
    font-size: 22px;
    line-height: 24px;
    text-align: center;
  }

  .condition-row strong {
    font-size: 20px;
    line-height: 22px;
    letter-spacing: 0.2px;
  }

  .day-desc {
    color: var(--text);
    font-size: 11px;
    line-height: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .weather-metrics {
    height: 25px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    margin-top: 1px;
  }

  .temp-pair strong {
    color: var(--line);
    font-size: 20px;
    line-height: 22px;
  }

  .temp-pair span {
    color: var(--text);
    font-size: 14px;
    font-weight: 800;
  }

  .humidity {
    color: var(--accent);
    font-size: 11px;
    font-weight: 900;
  }

  .solar-window {
    margin-top: auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px;
  }

  .solar-item {
    height: 32px;
    display: grid;
    grid-template-columns: 22px 1fr;
    align-items: center;
    border: 1px solid var(--orange);
    padding: 2px 3px;
  }

  .solar-item.sunset {
    border-color: var(--line);
  }

  .solar-icon {
    width: 18px;
    height: 18px;
    border: 2px solid var(--orange);
    border-radius: 50%;
    color: var(--warn);
    display: grid;
    place-items: center;
    font-size: 13px;
    line-height: 13px;
    font-weight: 900;
  }

  .sunset .solar-icon {
    border-color: var(--line);
    color: var(--line);
  }

  .solar-copy {
    display: flex;
    flex-direction: column;
  }

  .solar-copy small {
    color: var(--muted);
    font-size: 7px;
    line-height: 8px;
    font-weight: 900;
    letter-spacing: 0.2px;
  }

  .solar-copy strong {
    color: var(--text);
    font-size: 11px;
    line-height: 12px;
  }

  .headline-list {
    height: 154px;
    display: grid;
    grid-template-rows: repeat(6, 1fr);
    gap: 1px;
  }

  .headline-item {
    min-height: 0;
    display: grid;
    grid-template-columns: 25px 47px minmax(0, 1fr) 82px;
    align-items: center;
    column-gap: 5px;
    border-bottom: 1px solid var(--line);
  }

  .headline-item:last-child {
    border-bottom: 0;
  }

  .headline-index {
    height: 18px;
    background: var(--line);
    color: #ffffff;
    display: grid;
    place-items: center;
    font-size: 10px;
    line-height: 10px;
    font-weight: 900;
  }

  .topic-chip {
    border: 1px solid var(--accent);
    color: var(--accent);
    padding: 1px 2px;
    font-size: 8px;
    line-height: 11px;
    font-weight: 900;
    text-align: center;
    white-space: nowrap;
  }

  .topic-world,
  .topic-business,
  .topic-technology {
    border-color: var(--line);
    color: var(--line);
  }

  .topic-culture,
  .topic-sports {
    border-color: var(--orange);
    color: var(--warn);
  }

  .headline-item h2 {
    min-width: 0;
    margin: 0;
    color: var(--text);
    font-size: 14px;
    line-height: 17px;
    font-weight: 800;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .headline-source {
    min-width: 0;
    color: var(--muted);
    font-size: 9px;
    line-height: 11px;
    font-weight: 700;
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .corner-note {
    position: absolute;
    right: 8px;
    bottom: 6px;
    color: var(--line);
    font-size: 11px;
    font-weight: 900;
    background: #ffffff;
    border: 1px solid var(--line);
    padding: 1px 5px;
    line-height: 16px;
  }
</style>
